# Azure Ethereum Testnet Configuration
# Source this file before running scripts: source ./config.env

# =============================================================================
# Network Settings
# =============================================================================
export CHAIN_ID=3151909
export NETWORK_NAME="azure-testnet"
export DEPOSIT_CONTRACT_ADDRESS="0x00000000219ab540356cBB839Cbe05303d7705Fa"

# =============================================================================
# Validator Settings
# =============================================================================
export NUM_VALIDATORS=128
export MIN_GENESIS_ACTIVE_VALIDATOR_COUNT=64

# =============================================================================
# Azure Settings
# =============================================================================
export AZURE_KV_NAME="jx3-mqube-dev-build"
export ENVIRONMENT="staging"

# =============================================================================
# GitHub Settings (for static files)
# =============================================================================
export GITHUB_REPO="spring-financial-group/ethereum-config-chains"
export NETWORK_DIR="network-configs/azure-testnet"

# =============================================================================
# Paths (relative to jx-staging-files/)
# =============================================================================
export ACCOUNTS_DIR="./accounts"
export VALIDATOR_KEYS_DIR="./validator_keys"
export GENESIS_DIR="./genesis"
export SECRETS_DIR="./secrets"

# =============================================================================
# Account Files (generated by Step 1)
# =============================================================================
export ACCOUNTS_FILE="${ACCOUNTS_DIR}/accounts.txt"
export GENESIS_ALLOC_FILE="${ACCOUNTS_DIR}/genesis_alloc.json"
export FEE_RECIPIENT_FILE="${ACCOUNTS_DIR}/fee_recipient_account.txt"
export WITHDRAWAL_FILE="${ACCOUNTS_DIR}/withdrawal_account.txt"

# These will be populated after running generate-accounts.sh
export FEE_RECIPIENT_ADDRESS=""
export WITHDRAWAL_ADDRESS=""

# =============================================================================
# Script Locations (relative to jx-staging-files/)
# =============================================================================
export LEARTECH_SECRETS_SCRIPTS="../leartech-secrets/scripts"
export WEBSIGNER_SCRIPTS="../WebSignerSetup/scripts"
export ETHEREUM_CONFIG_CHAINS="../BlockChain/ethereum-config-chains"

# Note: generate-accounts.sh is in jx-staging-files/
# Run from accounts/ subdirectory as: ../generate-accounts.sh
